# fsbackup web UI — environment configuration
# Copy to web/.env and edit. All values shown are the defaults.
# When running under systemd, these can also be set via Environment= in the unit file.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Bind address. Set HOST to a specific internal address (e.g. your management
# IP) instead of 0.0.0.0 to limit the listening surface — see the "Web UI
# security" section in docs/reference.md.
HOST=0.0.0.0
PORT=8080

# ---------------------------------------------------------------------------
# Paths (must match fsbackup.conf)
# ---------------------------------------------------------------------------
SNAPSHOT_ROOT=/backup/snapshots
TARGETS_FILE=/etc/fsbackup/targets.yml

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Login is a single shared password checked against a bcrypt hash. The username
# field on the login form is accepted but not verified — there is no PAM or
# system-account integration.
#
# Set AUTH_ENABLED=false to disable login entirely (only on a trusted network).
AUTH_ENABLED=true

# bcrypt hash of the login password. web/install.sh generates this for you.
# To set it by hand:
#   python3 -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
# AUTH_PASSWORD_HASH=

# Stable secret key for session cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random key is generated at startup (sessions reset on restart).
# SECRET_KEY=changeme

# ---------------------------------------------------------------------------
# S3 offsite
# ---------------------------------------------------------------------------
S3_BUCKET=fsbackup-snapshots-SUFFIX
S3_PROFILE=fsbackup
S3_REGION=us-west-2
# Presigned download URL lifetime in seconds (default 3600 = 1 hour)
# PRESIGN_TTL=3600
