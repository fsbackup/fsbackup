SNAPSHOT_ROOT="/backup/snapshots"

# ZFS pool name (derived from SNAPSHOT_ROOT if unset — strip leading /)
# ZFS_POOL="backup"

# Log files (backup-<class>.log, retention.log, s3-export.log, doctor-<class>.log,
# fs-orphans.log, scrub.log). Defaults to /var/log/fsbackup when unset. Use a
# literal path: the web UI reads this value without running the file. If you
# change it, also update the path in /etc/logrotate.d/fsbackup and create the
# directory owned by fsbackup:fsbackup, mode 0750.
LOG_DIR="/var/log/fsbackup"

# =============================================================================
# Schedule — OnCalendar= values for each class/type
# Applied to systemd timers via: sudo fs-schedule-apply.sh
# Format: https://www.freedesktop.org/software/systemd/man/systemd.time.html
# =============================================================================

CLASS1_DAILY_SCHEDULE="*-*-* 01:45"
CLASS1_WEEKLY_SCHEDULE="Sat *-*-* 02:00"
CLASS1_MONTHLY_SCHEDULE="*-*-01 03:00"

CLASS2_DAILY_SCHEDULE="*-*-* 02:15"
CLASS2_WEEKLY_SCHEDULE="Sat *-*-* 02:30"
# CLASS2_MONTHLY_SCHEDULE=""   # omit to disable monthly class2 runs

CLASS3_MONTHLY_SCHEDULE="*-*-01 04:00"
# CLASS3_DAILY_SCHEDULE=""     # omit to disable daily class3 runs

# =============================================================================
# Retention — how many ZFS snapshots of each type to keep per target
# Applied by fs-retention.sh (runs daily via fsbackup-retention.timer)
# KEEP_ANNUAL=0 means keep all annual snapshots indefinitely
# =============================================================================

KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=12
KEEP_ANNUAL=0

# =============================================================================
# ZFS scrub — fs-scrub-check.sh (monthly via fsbackup-scrub.timer, as root)
# Scrubs ZFS_POOL (above; default: the pool holding SNAPSHOT_ROOT) and fails
# the unit on any error. The doctor warns if the last clean scrub is older than
# SCRUB_MAX_AGE_DAYS or the last scrub check failed.
# =============================================================================

# SCRUB_MAX_AGE_DAYS=35

# =============================================================================
# S3 export
# =============================================================================

S3_BUCKET="fsbackup-snapshots-XXXXXX"

# Space-separated list of classes to exclude from S3 export.
# S3_SKIP_CLASSES="class3"
S3_SKIP_CLASSES=""

# S3_AWS_PROFILE="fsbackup"    # defaults to fsbackup if unset
